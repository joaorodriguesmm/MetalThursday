{
    "$schema": "https://json.schemastore.org/package.json",
    "name": "metal-thursday",
    "version": "1.0.0",
    "description": "Aplicação web da rubrica semanal MetalThursday.",
    "private": true,
    "type": "module",
    "engines": {
        "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
    },
    "scripts": {
