{
    "$schema": "https://json.schemastore.org/package.json",
    "name": "metal-thursday",
    "description": "Aplicação web da rubrica semanal MetalThursday.",
    "private": true,
    "type": "module",
    "engines": {
        "node": "^22.13.0 || ^24.0.0"
    },
    "scripts": {
        "desenvolver": "vite",
        "compilar": "vite build",
        "validar:javascript": "eslint . --max-warnings=0",
        "corrigir:javascript": "eslint . --fix",
        "validar": "npm run validar:javascript && npm run compilar"
    },
    "dependencies": {
        "@popperjs/core": "^2.11.8",
        "axios": "^1.19.0",
        "bootstrap": "^5.3.8",
        "bootstrap-icons": "^1.13.1",
        "sweetalert2": "^11.26.25",
        "tom-select": "^2.6.2"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "concurrently": "^10.0.4",
        "eslint": "^10.8.1",
        "globals": "^17.10.0",
        "laravel-vite-plugin": "^3.2.0",
        "sass": "^1.102.0",
        "vite": "^8.2.1"
    },
    "allowScripts": {
        "@parcel/watcher@2.6.0": true
    }
}
