{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "joao-rodrigues-multimedia/metalthursday",
    "type": "project",
    "description": "Aplicação web da rubrica semanal MetalThursday.",
    "keywords": [
        "metal",
        "musica",
        "laravel",
        "blade"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.61.1",
        "laravel/tinker": "^2.10.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.24",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5.50"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "desenvolver": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fdba74\" \"php artisan serve --env=reconstrucao\" \"php artisan queue:listen --env=reconstrucao --tries=1\" \"npm run desenvolver\" --names=servidor,fila,vite --kill-others"
        ],
        "formatar": "pint",
        "testar": [
            "@php artisan config:clear --env=testing --ansi",
            "@php artisan test --env=testing --ansi"
        ]
    },
    "scripts-descriptions": {
        "desenvolver": "Inicia o servidor, a fila e o Vite no ambiente de reconstrução.",
        "formatar": "Formata os ficheiros PHP com o Laravel Pint.",
        "testar": "Executa os testes automatizados no ambiente de testes."
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
